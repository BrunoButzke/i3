{
  "name": "i3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:generate:docker": "docker exec -e PUID=$(id -u) -e PGID=$(id -g) i3-app sh -c 'npx prisma generate && chown -R $PUID:$PGID /app/src/generated'",
    "prisma:push:docker": "docker exec i3-app npx prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "db:import": "tsx scripts/import-from-xlsx.ts",
    "db:maintenance": "tsx scripts/db-maintenance.ts",
    "db:seed": "tsx scripts/seed.ts",
    "docker:up": "docker compose up --build",
    "docker:up:db": "docker compose up db -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.1",
    "jose": "^6.2.3",
    "next": "^15.3.3",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "jsdom": "^26.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
